# Express application server
PORT=3000

# PostgreSQL connection for the separate Python SQLAlchemy database foundation.
# Use a local development database; never commit production credentials.
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/avoidable_ed_navigator

# Required to sign Flask session cookies (registration/login/logout).
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real secret. The application fails to start if this is unset.
SECRET_KEY=replace-with-a-long-random-secret

# Optional: enables Gemini-powered care-plan, triage, and copilot responses.
# Without this value, the app uses its built-in safe offline fallback responses.
GEMINI_API_KEY=your_gemini_api_key_here
