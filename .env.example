# Express application server
PORT=3000

# PostgreSQL connection for the separate Python SQLAlchemy database foundation.
# Use a local development database; never commit production credentials.
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/avoidable_ed_navigator

# Required to sign Flask session cookies (registration/login/logout).
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real secret. The application fails to start if this is unset.
SECRET_KEY=replace-with-a-long-random-secret

# Optional: enables Gemini-powered care-plan, triage, and copilot responses.
# Without this value, the app uses its built-in safe offline fallback responses.
GEMINI_API_KEY=your_gemini_api_key_here

# Offline RAG knowledge-base ingestion only. These values are never used at
# Flask startup. Use an existing Pinecone index whose dimension equals the
# configured embedding dimension; do not put member or patient data in it.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=avoidable-ed-knowledge
PINECONE_KNOWLEDGE_NAMESPACE=knowledge-base
PINECONE_INDEX_METRIC=cosine
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSION=768

# Server-side OpenRouteService key for urgent-care route calculations.
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
